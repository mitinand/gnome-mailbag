<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<!-- SPDX-FileCopyrightText: 2026 Andrey Mitin
     SPDX-License-Identifier: GPL-3.0-or-later -->
<interface domain="mailbag">
  <!-- interface-name mailbag.ui -->
  <requires lib="gio" version="2.0"/>
  <requires lib="gtk" version="4.12"/>
  <requires lib="libadwaita" version="1.8"/>
  <object class="AdwWindow" id="window">
    <property name="content">
      <object class="AdwToastOverlay" id="toasts">
        <property name="child">
          <object class="AdwOverlaySplitView" id="folders_split">
            <property name="content">
              <object class="AdwNavigationSplitView" id="mail_split">
                <property name="content">
                  <object class="AdwNavigationPage">
                    <property name="child">
                      <object class="AdwToolbarView">
                        <property name="content">
                          <object class="GtkStack" id="reader_stack">
                            <property name="vexpand">true</property>
                            <child>
                              <object class="GtkStackPage">
                                <property name="child">
                                  <object class="GtkScrolledWindow" id="reader_scroll">
                                    <property name="child">
                                      <object class="GtkBox" id="message_content">
                                        <property name="margin-bottom">24</property>
                                        <property name="margin-end">24</property>
                                        <property name="margin-start">24</property>
                                        <property name="margin-top">24</property>
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">22</property>
                                        <child>
                                          <object class="GtkLabel" id="reader_subject">
                                            <property name="label"/>
                                            <property name="wrap">true</property>
                                            <property name="xalign">0</property>
                                            <style>
                                              <class name="title-1"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox" id="current_message_list">
                                            <property name="orientation">vertical</property>
                                            <property name="visible">false</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSeparator" id="message_separator">
                                            <property name="visible">false</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox" id="earlier_message_list">
                                            <property name="orientation">vertical</property>
                                            <property name="visible">false</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox" id="singleton_slot">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">10</property>
                                            <property name="visible">false</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSeparator" id="context_separator">
                                            <property name="visible">false</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox" id="context">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">10</property>
                                            <property name="visible">false</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Sent · Conversation context</property>
                                                <property name="xalign">0</property>
                                                <style>
                                                  <class name="heading"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Outside this folder; excluded from list actions.</property>
                                                <property name="wrap">true</property>
                                                <property name="xalign">0</property>
                                                <style>
                                                  <class name="caption"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                    <property name="hscrollbar-policy">never</property>
                                    <property name="vexpand">true</property>
                                  </object>
                                </property>
                                <property name="name">message</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="child">
                                  <object class="AdwStatusPage">
                                    <property name="child">
                                      <object class="GtkButton" id="retry_button">
                                        <property name="halign">center</property>
                                        <property name="label" translatable="yes">Try Again</property>
                                      </object>
                                    </property>
                                    <property name="description" translatable="yes">The preview is saved, but the body is unavailable offline.</property>
                                    <property name="icon-name">network-offline-symbolic</property>
                                    <property name="title" translatable="yes">Message not downloaded</property>
                                  </object>
                                </property>
                                <property name="name">offline</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="child">
                                  <object class="AdwStatusPage" id="loading_status">
                                    <property name="description"/>
                                    <property name="paintable">
                                      <object class="AdwSpinnerPaintable" id="loading_spinner">
                                        <property name="widget">loading_status</property>
                                      </object>
                                    </property>
                                    <property name="title" translatable="yes">Loading message</property>
                                  </object>
                                </property>
                                <property name="name">loading</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="child">
                                  <object class="AdwStatusPage">
                                    <property name="description" translatable="yes">Choose a conversation from the list.</property>
                                    <property name="icon-name">mail-read-symbolic</property>
                                    <property name="title" translatable="yes">Select a message</property>
                                  </object>
                                </property>
                                <property name="name">unselected</property>
                              </object>
                            </child>
                            <property name="visible-child-name">unselected</property>
                          </object>
                        </property>
                        <child type="top">
                          <object class="AdwHeaderBar" id="reader_header">
                            <property name="show-title">false</property>
                            <property name="title-widget">
                              <object class="AdwWindowTitle">
                                <property name="title">Mailbag</property>
                              </object>
                            </property>
                            <child type="end">
                              <object class="GtkMenuButton" id="demo_button">
                                <property name="icon-name">view-more-symbolic</property>
                                <property name="menu-model">reading_menu</property>
                                <property name="tooltip-text" translatable="yes">Message Menu</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                            <child type="end">
                              <object class="GtkButton" id="reader_trash">
                                <property name="action-name">app.trash</property>
                                <property name="icon-name">user-trash-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Move to Trash</property>
                              </object>
                            </child>
                            <child type="start">
                              <object class="GtkButton" id="reader_folders">
                                <property name="action-name">app.folders</property>
                                <property name="icon-name">sidebar-show-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Accounts and Folders</property>
                                <property name="visible">false</property>
                              </object>
                            </child>
                            <child type="end">
                              <object class="GtkButton" id="reader_move">
                                <property name="action-name">app.move</property>
                                <property name="icon-name">folder-open-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Move messages to another folder</property>
                              </object>
                            </child>
                            <child type="end">
                              <object class="GtkButton" id="reader_archive">
                                <property name="action-name">app.archive</property>
                                <property name="icon-name">package-x-generic-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Archive messages represented in this mailbox</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="title" translatable="yes">Message</property>
                  </object>
                </property>
                <property name="min-sidebar-width">300</property>
                <property name="show-content">true</property>
                <property name="sidebar">
                  <object class="AdwNavigationPage" id="list_page">
                    <property name="child">
                      <object class="AdwToolbarView">
                        <property name="content">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkSearchBar" id="search_bar">
                                <property name="child">
                                  <object class="GtkSearchEntry" id="search_entry">
                                    <property name="placeholder-text" translatable="yes">Search all accounts</property>
                                  </object>
                                </property>
                                <property name="show-close-button">true</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStack" id="list_stack">
                                <property name="vexpand">true</property>
                                <child>
                                  <object class="GtkStackPage">
                                    <property name="child">
                                      <object class="GtkScrolledWindow" id="list_scroll">
                                        <property name="child">
                                          <object class="GtkListBox" id="messages">
                                            <property name="selection-mode">single</property>
                                            <style>
                                              <class name="list"/>
                                            </style>
                                          </object>
                                        </property>
                                        <property name="hscrollbar-policy">never</property>
                                        <property name="vexpand">true</property>
                                      </object>
                                    </property>
                                    <property name="name">messages</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkStackPage">
                                    <property name="child">
                                      <object class="AdwStatusPage">
                                        <property name="description" translatable="yes">This folder is empty.</property>
                                        <property name="icon-name">mail-unread-symbolic</property>
                                        <property name="title" translatable="yes">No messages</property>
                                      </object>
                                    </property>
                                    <property name="name">empty</property>
                                  </object>
                                </child>
                                <property name="visible-child-name">empty</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <child type="top">
                          <object class="AdwHeaderBar" id="list_header">
                            <property name="title-widget">
                              <object class="AdwWindowTitle" id="list_title">
                                <property name="subtitle"/>
                                <property name="title" translatable="yes">All Inboxes</property>
                              </object>
                            </property>
                            <child type="start">
                              <object class="GtkButton" id="folders_button">
                                <property name="icon-name">sidebar-show-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Accounts and folders</property>
                                <property name="valign">center</property>
                                <property name="visible">true</property>
                                <property name="action-name">app.folders</property>
                              </object>
                            </child>
                            <child type="end">
                              <object class="GtkButton" id="search_button">
                                <property name="icon-name">system-search-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Search All Accounts (Ctrl+F)</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                            <child type="end">
                              <object class="GtkToggleButton" id="unread_filter">
                                <property name="icon-name">mail-unread-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Show unread only</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="title" translatable="yes">All Inboxes</property>
                  </object>
                </property>
                <property name="sidebar-width-fraction">0.38</property>
                <property name="sidebar-width-unit">sp</property>
                <property name="max-sidebar-width">420</property>
              </object>
            </property>
            <property name="max-sidebar-width">350</property>
            <property name="min-sidebar-width">200</property>
            <property name="sidebar">
              <object class="AdwToolbarView">
                <property name="content">
                  <object class="GtkScrolledWindow">
                    <property name="child">
                      <object class="GtkListView" id="folder_tree">
                        <property name="single-click-activate">true</property>
                        <style>
                          <class name="navigation-sidebar"/>
                        </style>
                      </object>
                    </property>
                    <property name="hscrollbar-policy">never</property>
                    <property name="vexpand">true</property>
                  </object>
                </property>
                <child type="top">
                  <object class="AdwHeaderBar" id="sidebar_header">
                    <property name="title-widget">
                      <object class="AdwWindowTitle">
                        <property name="title">Mailbag</property>
                      </object>
                    </property>
                    <child type="end">
                      <object class="GtkMenuButton" id="app_menu_button">
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="menu-model">application_menu</property>
                        <property name="tooltip-text" translatable="yes">Main Menu</property>
                        <property name="valign">center</property>
                        <property name="primary">true</property>
                      </object>
                    </child>
                    <child type="start">
                      <object class="GtkBox" id="sync_button_list">
                        <child>
                          <object class="GtkStack" id="sync_icon_list">
                            <child>
                              <object class="GtkStackPage">
                                <property name="child">
                                  <object class="AdwSpinner" id="sync_spinner_list">
                                    <property name="height-request">16</property>
                                    <property name="width-request">16</property>
                                  </object>
                                </property>
                                <property name="name">active</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="child">
                                  <object class="GtkImage">
                                    <property name="icon-name">emblem-ok-symbolic</property>
                                  </object>
                                </property>
                                <property name="name">done</property>
                              </object>
                            </child>
                            <property name="margin-start">8</property>
                            <property name="margin-end">8</property>
                            <property name="margin-top">8</property>
                            <property name="margin-bottom">8</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkPopover" id="sync_popover">
                            <property name="child">
                              <object class="GtkBox">
                                <property name="margin-bottom">16</property>
                                <property name="margin-end">16</property>
                                <property name="margin-start">16</property>
                                <property name="margin-top">16</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel" id="sync_title_list">
                                    <property name="label" translatable="yes">Synchronizing mail</property>
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="heading"/>
                                    </style>
                                    <property name="wrap">true</property>
                                    <property name="wrap-mode">word-char</property>
                                    <property name="max-width-chars">32</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="sync_account_list">
                                    <property name="ellipsize">end</property>
                                    <property name="label"/>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="sync_stage_list">
                                    <property name="label" translatable="yes">Downloading message headers</property>
                                    <property name="wrap">true</property>
                                    <property name="xalign">0</property>
                                    <property name="wrap-mode">word-char</property>
                                    <property name="max-width-chars">32</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkProgressBar" id="sync_progress_list"/>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="sync_detail_list">
                                    <property name="label"/>
                                    <property name="wrap">true</property>
                                    <property name="xalign">0</property>
                                    <property name="wrap-mode">word-char</property>
                                    <property name="max-width-chars">32</property>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                        <property name="valign">center</property>
                        <property name="accessible-role">status</property>
                        <accessibility>
                          <property name="label" translatable="yes">Synchronization status</property>
                        </accessibility>
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <property name="sidebar-width-fraction">0.24</property>
          </object>
        </property>
      </object>
    </property>
    <property name="default-height">900</property>
    <property name="default-width">1440</property>
    <property name="height-request">294</property>
    <property name="title" translatable="yes">Mailbag</property>
    <property name="width-request">360</property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 1100sp</condition>
        <setter object="folders_split" property="collapsed">true</setter>
        <setter object="folders_split" property="show-sidebar">false</setter>
        <setter object="folders_button" property="visible">true</setter>
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 720sp</condition>
        <setter object="folders_split" property="collapsed">true</setter>
        <setter object="folders_split" property="show-sidebar">false</setter>
        <setter object="folders_button" property="visible">true</setter>
        <setter object="mail_split" property="collapsed">true</setter>
        <setter object="reader_folders" property="visible">true</setter>
        <setter object="reader_move" property="visible">false</setter>
      </object>
    </child>
  </object>
  <menu id="application_menu">
    <section>
      <item>
        <attribute name="action">app.accounts</attribute>
        <attribute name="label" translatable="yes">_Online Accounts…</attribute>
      </item>
      <item>
        <attribute name="action">app.sync-status</attribute>
        <attribute name="label" translatable="yes">_Synchronization Status</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="action">app.preferences</attribute>
        <attribute name="label" translatable="yes">_Preferences</attribute>
      </item>
      <item>
        <attribute name="action">app.shortcuts</attribute>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
      </item>
      <item>
        <attribute name="action">app.about</attribute>
        <attribute name="label" translatable="yes">_About Mailbag</attribute>
      </item>
    </section>
  </menu>
  <menu id="reading_menu">
    <section>
      <item>
        <attribute name="action">app.move</attribute>
        <attribute name="label" translatable="yes">_Move…</attribute>
      </item>
      <item>
        <attribute name="action">app.mark-scope-read</attribute>
        <attribute name="label" translatable="yes">Mark as _Read</attribute>
      </item>
      <item>
        <attribute name="action">app.mark-scope-unread</attribute>
        <attribute name="label" translatable="yes">Mark as _Unread</attribute>
      </item>
      <item>
        <attribute name="action">app.junk</attribute>
        <attribute name="label" translatable="yes">Move to _Junk</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="action">app.expand</attribute>
        <attribute name="label" translatable="yes">_Expand All Messages</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="action">app.collapse</attribute>
        <attribute name="label" translatable="yes">_Collapse All Messages</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
  </menu>
</interface>

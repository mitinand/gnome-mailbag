<interface domain="mailbag">
  <!-- interface-name conversation-message.ui -->
  <requires lib="gtk" version="4.12"/>
  <requires lib="libadwaita" version="1.8"/>
  <object class="GtkExpander" id="conversation_message">
    <property name="expanded">false</property>
    <property name="label-widget">
      <object class="GtkLabel" id="conversation_message_label">
        <property name="ellipsize">end</property>
        <property name="hexpand">true</property>
        <property name="label"/>
        <property name="single-line-mode">true</property>
        <property name="xalign">0</property>
      </object>
    </property>
    <property name="visible">true</property>
    <child>
      <object class="GtkBox" id="message_slot">
        <property name="orientation">vertical</property>
      </object>
    </child>
  </object>
</interface>
